  function mines(root){
    const R=9,C=9,M=10;
    root.innerHTML=`<div class="gcol"><div class="gscore"><span>Mines <b class="ml">${M}</b></span><span>Time <b class="mt">0</b></span><span>Best <b class="mb2">${best('mine')||'-'}</b></span></div><div class="msgrid" role="grid" aria-label="Minesweeper board"></div><p class="gmsg" aria-live="polite">Click a square to start. Right-click or use Flag mode to place flags.</p><div class="arow"><button type="button" class="btn" data-k="flag" aria-pressed="false">Flag mode: off</button><button type="button" class="btn" data-k="new">New game</button></div></div>`;
    const grid=$('.msgrid',root),msg=$('.gmsg',root),ml=$('.ml',root),mt=$('.mt',root),mb=$('.mb2',root),fb=$('[data-k=flag]',root);
