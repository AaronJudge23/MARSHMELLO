function crateState(){
  let s={inv:{},eq:{},last:0,q:{m:0,s:0},pity:0};
  try{const x=JSON.parse(ls.getItem('halcyon.crates')||'null');if(x&&typeof x==='object'){
    if(typeof x.last==='number'&&x.last>0&&x.last<=Date.now()+1000)s.last=x.last;
    if(Number.isFinite(x.pity))s.pity=Math.max(0,Math.min(PITY-1,Math.floor(x.pity)));
    if(x.q&&typeof x.q==='object'){if(Number.isFinite(x.q.m))s.q.m=Math.max(0,Math.min(Q_MSG,Math.floor(x.q.m)));if(Number.isFinite(x.q.s))s.q.s=Math.max(0,Math.min(Q_SEC,Math.floor(x.q.s)))}
    if(x.inv&&typeof x.inv==='object')for(const k of Object.keys(x.inv))if(/^(bubble|font|tag|ring|fx):/.test(k)){const [c,...r]=k.split(':');if(itemInfo(c,r.join(':')))s.inv[k]=1}
    if(x.eq&&typeof x.eq==='object')for(const c of ['bubble','font','tag','ring','fx'])if(typeof x.eq[c]==='string'&&s.inv[c+':'+x.eq[c]])s.eq[c]=x.eq[c];
  }}catch(e){}
