      for(const [dr,dc] of DG){let rr=r+dr,cc=c+dc;while(inb(rr,cc)){const p=b[rr*8+cc];if(p){if(p===(W?'B':'b')||p===(W?'Q':'q'))return true;break}rr+=dr;cc+=dc}}
