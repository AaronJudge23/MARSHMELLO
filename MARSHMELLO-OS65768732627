function rollItem(crate,force){
  let pool=crate.pool().map(([c,k])=>({c,k,w:RW[itemInfo(c,k).r]}));
  if(force){const e=pool.filter(x=>itemInfo(x.c,x.k).r==='e');if(e.length)pool=e}
  const tot=pool.reduce((a,x)=>a+x.w,0),u=new Uint32Array(1);crypto.getRandomValues(u);
