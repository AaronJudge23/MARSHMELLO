  function open(nm=sel){
    if(!nm)return;const nd=get([...cwd,nm]);if(!nd)return;
    if(nd.t==='d'){cwd=[...cwd,nm];sel=null;render()}else openApp('notes',{path:[...cwd,nm]});
  }
  function del(){
    if(!sel)return;const err=rmNode([...cwd,sel]);
    if(err){stat.className='fstat bad';stat.textContent=err}else sel=null;
  }
  const showAdd=k=>{kind=k;form.hidden=false;ain.placeholder=k==='d'?'Folder name':'File name (e.g. notes.txt)';ain.value='';ain.focus()};
