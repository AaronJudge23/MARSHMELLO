/* Timer: countdown and stopwatch */
function mountTimer(w,b){
  b.innerHTML=`<div class="gm"><div class="gtabs" role="tablist"></div><div class="tmr"></div></div>`;
  const tabs=$('.gtabs',b),root=$('.tmr',b);
  let iv=null,ctx=null;
  const pad=n=>String(n).padStart(2,'0');
  const fmt=ms=>{const s=Math.floor(ms/1000),h=Math.floor(s/3600);return (h?h+':':'')+pad(Math.floor(s%3600/60))+':'+pad(s%60)};
  const stop=()=>{clearInterval(iv);iv=null};
  function beep(){
    try{const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;ctx=ctx||new AC();if(ctx.state==='suspended')ctx.resume();
      for(let i=0;i<3;i++){const o=ctx.createOscillator(),g=ctx.createGain(),t=ctx.currentTime+i*.35;o.frequency.value=880;g.gain.setValueAtTime(.2,t);g.gain.exponentialRampToValueAtTime(.0001,t+.25);o.connect(g);g.connect(ctx.destination);o.start(t);o.stop(t+.27)}}catch(e){}
  }
  function countdown(){
    root.innerHTML=`<div class="tbig" aria-live="off">05:00</div><div class="tin"><label>Min<input type="number" min="0" max="999" value="5" data-k="m" inputmode="numeric"></label><label>Sec<input type="number" min="0" max="59" value="0" data-k="s" inputmode="numeric"></label></div><div class="arow"><button type="button" class="btn pri" data-k="go">Start</button><button type="button" class="btn" data-k="rs">Reset</button></div><p class="gmsg" aria-live="polite"></p>`;
    const big=$('.tbig',root),mi=$('[data-k=m]',root),se=$('[data-k=s]',root),go=$('[data-k=go]',root),msg=$('.gmsg',root);
    let left=0,end=0,run=false;
    const read=()=>Math.max(0,Math.min(999,Math.floor(+mi.value||0)))*60+Math.max(0,Math.min(59,Math.floor(+se.value||0)));
    const show=()=>{big.textContent=fmt(run?left:read()*1000)};
    function tick(){left=Math.max(0,end-Date.now());show();if(left<=0){stop();run=false;go.textContent='Start';mi.disabled=se.disabled=false;msg.textContent="Time's up!";beep()}}
    go.onclick=()=>{
      if(run){stop();run=false;left=end-Date.now();go.textContent='Resume';return}
      if(!left){left=read()*1000;if(!left)return}
      end=Date.now()+left;run=true;mi.disabled=se.disabled=true;msg.textContent='';go.textContent='Pause';stop();iv=setInterval(tick,200);tick();
    };
    $('[data-k=rs]',root).onclick=()=>{stop();run=false;left=0;go.textContent='Start';mi.disabled=se.disabled=false;msg.textContent='';show()};
    mi.oninput=se.oninput=()=>{if(!run&&!left)show()};
    show();
  }
  function stopwatch(){
    root.innerHTML=`<div class="tbig">00:00.0</div><div class="arow"><button type="button" class="btn pri" data-k="go">Start</button><button type="button" class="btn" data-k="lap" disabled>Lap</button><button type="button" class="btn" data-k="rs">Reset</button></div><ol class="lapl" aria-label="Laps"></ol>`;
    const big=$('.tbig',root),go=$('[data-k=go]',root),lap=$('[data-k=lap]',root),ol=$('.lapl',root);
    let acc=0,st=0,run=false,laps=[];
    const now=()=>acc+(run?Date.now()-st:0);
    const f=ms=>pad(Math.floor(ms/60000))+':'+pad(Math.floor(ms/1000)%60)+'.'+Math.floor(ms/100)%10;
    const show=()=>{big.textContent=f(now())};
    go.onclick=()=>{
      if(run){acc+=Date.now()-st;run=false;stop();go.textContent='Resume';lap.disabled=true;show();return}
      st=Date.now();run=true;go.textContent='Pause';lap.disabled=false;stop();iv=setInterval(show,100);
    };
    lap.onclick=()=>{laps.push(now());ol.innerHTML='';laps.forEach((t,i)=>{const li=el('li');li.append(el('span','','Lap '+(i+1)),el('span','',f(t-(laps[i-1]||0))+'  ('+f(t)+')'));ol.prepend(li)})};
    $('[data-k=rs]',root).onclick=()=>{stop();run=false;acc=0;laps=[];ol.innerHTML='';go.textContent='Start';lap.disabled=true;show()};
  }
  function open(id){
    stop();$$('.gtabs button').forEach(x=>{if(b.contains(x))x.setAttribute('aria-selected',x.dataset.id===id)});
    id==='cd'?countdown():stopwatch();
  }
  [['cd','Timer'],['sw','Stopwatch']].forEach(t=>{const x=el('button','gtab',t[1]);x.type='button';x.dataset.id=t[0];x.setAttribute('role','tab');x.onclick=()=>open(t[0]);tabs.append(x)});
  w.cleanup.push(()=>{stop();if(ctx)try{ctx.close()}catch(e){}});
  open('cd');
}

